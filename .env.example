DATABASE_URL="postgresql://postgres:password@localhost:5432/future_finance_v2"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Field-level encryption at rest — see docs/encryption-at-rest.md
# 32 raw bytes, base64. Mint with: openssl rand -base64 32
# LOSING THIS KEY MEANS LOSING THE ENCRYPTED DATA — back it up outside the host.
DATA_ENCRYPTION_KEY=""
# Which key in the ring new writes are sealed with (envelope prefix `v1.<keyId>`).
DATA_ENCRYPTION_KEY_ID="k1"
# Only needed if User.email gets a blind index. Separate key — never reuse the AES key.
DATA_BLIND_INDEX_KEY=""

# Sentry — https://docs.sentry.io/platforms/javascript/guides/nextjs/
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
