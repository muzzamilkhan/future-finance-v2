DATABASE_URL="postgresql://postgres:password@localhost:5432/future_finance_v2"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Must be set explicitly in production too: on a custom domain NextAuth would
# otherwise fall back to Vercel's per-deployment *.vercel.app URL.
# Production: https://finance.muzza.tech
AUTH_URL="http://localhost:3000"

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://finance.muzza.tech/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Sentry — https://docs.sentry.io/platforms/javascript/guides/nextjs/
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
